# Life Plan Tracker — environment configuration
#
# Copy to `.env` for local use, or set these as environment variables in your
# runtime. The single switch DEPLOY_MODE selects local vs. AWS behavior.
# Nothing here should contain real secrets in local mode; in AWS mode secrets
# live in AWS Secrets Manager and are referenced by ARN.

# ---------------------------------------------------------------------------
# Deployment mode: "local" (default) or "aws"
# ---------------------------------------------------------------------------
DEPLOY_MODE=local

# ---------------------------------------------------------------------------
# LOCAL MODE settings (ignored when DEPLOY_MODE=aws)
# ---------------------------------------------------------------------------
# JWT signing secret for local dev. Generate a real one with:
#   openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# Local admin bootstrap credentials (dev convenience).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ---------------------------------------------------------------------------
# AWS MODE settings (required when DEPLOY_MODE=aws; ignored in local mode)
# ---------------------------------------------------------------------------
# Region for Secrets Manager + S3 clients.
AWS_REGION=us-east-1
# Secrets Manager reference holding {"username": "...", "password": "..."}.
ADMIN_SECRET_ARN=arn:aws:secretsmanager:us-east-1:809784555426:secret:life-planning/admin-credentials-dPvvor
# Secrets Manager reference holding the JWT secret (bare string or {"secret": "..."}).
JWT_SECRET_ARN=
# Private S3 bucket for user attachments (uploads).
UPLOADS_BUCKET=
# Presigned URL lifetime (seconds) for serving attachments in AWS mode.
PRESIGN_TTL_SECONDS=900
